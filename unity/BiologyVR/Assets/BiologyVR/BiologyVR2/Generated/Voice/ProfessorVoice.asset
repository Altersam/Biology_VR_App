    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439
      \u0448\u0438\u043F \u043D\u0430 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435
      \u2014 \u044D\u0442\u043E \u0435\u0433\u043E \xAB\u043B\u0438\u0446\u043E\xBB."
