  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: co2
  m_EditorClassIdentifier: 
  id: co2
  displayName: "\u0423\u0433\u043B\u0435\u043A\u0438\u0441\u043B\u044B\u0439 \u0433\u0430\u0437
    CO\u2082"
  requiredForCompletion: 0
  professorComment: "\u042D\u0442\u043E\u0442 \u0433\u0430\u0437 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
    \u0432 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.
    \u0415\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
    \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430."
  pages:
  - heading: "\u041F\u0443\u0442\u044C \u043E\u0442 \u0442\u043A\u0430\u043D\u0435\u0439"
    text: "\u2022 CO\u2082 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438 \u043E\u0431\u043C\u0435\u043D\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432
      \u0432 \u0442\u043A\u0430\u043D\u044F\u0445.\n\u2022 \u041E\u043D \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u0442\u043A\u0430\u043D\u0435\u0439 \u0432 \u043A\u0440\u043E\u0432\u044C.\n\u2022
      \u0412 \u043B\u0451\u0433\u043A\u0438\u0445 CO\u2082 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u043A\u0440\u043E\u0432\u0438 \u0438 \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442\u0441\u044F."
    visualConnection: "\u0422\u041A\u0410\u041D\u0418 \u2192 \u041A\u0420\u041E\u0412\u042C
      \u2192 \u041B\u0401\u0413\u041A\u0418\u0415"
  - heading: "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430"
    text: "\u2022 \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      CO\u2082 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043A\u0430\u043A HCO\u2083\u207B.\n\u2022 \u042D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u044B
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u044D\u0442\u043E\u043C\u0443
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044E.\n\u2022
      \u041A\u0430\u0440\u0431\u043E\u0430\u043D\u0433\u0438\u0434\u0440\u0430\u0437\u0430
      \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0440\u0435\u0430\u043A\u0446\u0438\u044E
      \u0432 \u043A\u043B\u0435\u0442\u043A\u0435."
    visualConnection: "CO\u2082 + H\u2082O \u21C4 H\u2082CO\u2083 \u21C4 H\u207A
      + HCO\u2083\u207B"
  - heading: "\u0414\u0440\u0443\u0433\u0438\u0435 \u0444\u043E\u0440\u043C\u044B"
    text: "\u2022 \u0427\u0430\u0441\u0442\u044C CO\u2082 \u0441\u0432\u044F\u0437\u0430\u043D\u0430
      \u0441 \u0431\u0435\u043B\u043A\u0430\u043C\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      Hb.\n\u2022 \u0427\u0430\u0441\u0442\u044C \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u0432 \u043F\u043B\u0430\u0437\u043C\u0435.\n\u2022 CO\u2082 \u043D\u0435
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0436\u0435\u043B\u0435\u0437\u043E\u043C
      \u0433\u0435\u043C\u0430 \u0442\u0430\u043A, \u043A\u0430\u043A O\u2082."
    visualConnection: "CO\u2082: HCO\u2083\u207B \xB7 \u0411\u0415\u041B\u041A\u0418
      \xB7 \u0420\u0410\u0421\u0422\u0412\u041E\u0420"
