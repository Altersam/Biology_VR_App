  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: platelet
  m_EditorClassIdentifier: 
  id: platelet
  displayName: "\u0422\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442"
  requiredForCompletion: 1
  professorComment: "\u042D\u0442\u043E\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435.
    \u041F\u043E\u0437\u0436\u0435 \u0442\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C,
    \u043A\u0430\u043A \u0432\u0430\u0436\u0435\u043D \u0435\u0433\u043E \u043A\u043E\u043D\u0442\u0430\u043A\u0442
    \u0441\u043E \u0441\u0442\u0435\u043D\u043A\u043E\u0439."
  pages:
  - heading: "\u0427\u0442\u043E \u044D\u0442\u043E"
    text: "\u2022 \u0422\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442 \u2014 \u0431\u0435\u0437\u044A\u044F\u0434\u0435\u0440\u043D\u044B\u0439
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u043C\u0435\u0433\u0430\u043A\u0430\u0440\u0438\u043E\u0446\u0438\u0442\u0430.\n\u2022
      \u041E\u0431\u044B\u0447\u043D\u043E \u043E\u043D \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0432 \u043A\u0440\u043E\u0432\u0438 \u0432 \u043F\u043E\u043A\u043E\u0435.\n\u2022
      \u0415\u0433\u043E \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u0443\u0447\u0430\u0441\u0442\u0438\u0435
      \u0432 \u0433\u0435\u043C\u043E\u0441\u0442\u0430\u0437\u0435."
    visualConnection: "\u0422\u0420\u041E\u041C\u0411\u041E\u0426\u0418\u0422 \u2192
      \u0413\u0415\u041C\u041E\u0421\u0422\u0410\u0417"
  - heading: "\u041F\u0435\u0440\u0432\u0438\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u0431\u043A\u0430"
    text: "\u2022 \u0410\u0434\u0433\u0435\u0437\u0438\u044F: \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u043A \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u043E\u0439
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.\n\u2022
      \u0410\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F: \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u0444\u043E\u0440\u043C\u044B \u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u044B.\n\u2022
      \u0410\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u044F: \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0442\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442\u043E\u0432."
    visualConnection: "\u0410\u0414\u0413\u0415\u0417\u0418\u042F \u2192 \u0410\u041A\u0422\u0418\u0412\u0410\u0426\u0418\u042F
      \u2192 \u0410\u0413\u0420\u0415\u0413\u0410\u0426\u0418\u042F"
  - heading: "\u0421\u0432\u044F\u0437\u044C \u0441\u043E \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0435\u0439"
    text: "\u2022 \u0422\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442\u044B \u0441\u043E\u0437\u0434\u0430\u044E\u0442
      \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u0443\u044E \u043F\u0440\u043E\u0431\u043A\u0443.\n\u2022
      \u0424\u0438\u0431\u0440\u0438\u043D \u0437\u0430\u0442\u0435\u043C \u0434\u0435\u043B\u0430\u0435\u0442
      \u0435\u0451 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0435\u0435.\n\u2022
      \u041F\u0440\u043E\u0431\u043A\u0430 \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u044D\u043D\u0434\u043E\u0442\u0435\u043B\u0438\u044F \u2014 \u0440\u0430\u0437\u043D\u044B\u0435
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B."
    visualConnection: "\u041F\u0415\u0420\u0412\u0418\u0427\u041D\u0410\u042F \u041F\u0420\u041E\u0411\u041A\u0410
      \u2192 \u0424\u0418\u0411\u0420\u0418\u041D"
