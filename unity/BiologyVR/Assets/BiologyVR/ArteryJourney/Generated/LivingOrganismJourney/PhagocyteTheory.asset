  id: phagocyte
  displayName: "\u0424\u0430\u0433\u043E\u0446\u0438\u0442"
  requiredForCompletion: 1
  professorComment: "\u042D\u0442\u0430 \u043A\u043B\u0435\u0442\u043A\u0430 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u0430\u043C \u0438 \u0443\u043C\u0435\u0435\u0442
    \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0442\u044C \u0447\u0443\u0436\u0435\u0440\u043E\u0434\u043D\u044B\u0435
    \u0447\u0430\u0441\u0442\u0438\u0446\u044B. \u0417\u0430\u043F\u043E\u043C\u043D\u0438
    \u0435\u0451 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430."
  pages:
  - heading: "\u0421\u0432\u044F\u0437\u044C \u0441 \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u0430\u043C\u0438"
    text: "\u2022 \u0424\u0430\u0433\u043E\u0446\u0438\u0442\u044B \u2014 \u0438\u043C\u043C\u0443\u043D\u043D\u044B\u0435
      \u043A\u043B\u0435\u0442\u043A\u0438 \u0441 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0439
      \u0444\u0430\u0433\u043E\u0446\u0438\u0442\u0430\u0440\u043D\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E.\n\u2022
      \u041E\u043D\u0438 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A
      \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u0430\u043C; \u044D\u0442\u043E
      \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0442
      \u043D\u0438\u0445 \u043A\u043B\u0430\u0441\u0441.\n\u2022 \u0417\u0434\u0435\u0441\u044C
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D \u0438\u0433\u0440\u043E\u0432\u043E\u0439
      \u0430\u0440\u0445\u0435\u0442\u0438\u043F \u0442\u0430\u043A\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0438."
    visualConnection: "\u041B\u0415\u0419\u041A\u041E\u0426\u0418\u0422\u042B \u2192
      \u0424\u0410\u0413\u041E\u0426\u0418\u0422\u0410\u0420\u041D\u0410\u042F \u0410\u041A\u0422\u0418\u0412\u041D\u041E\u0421\u0422\u042C"
  - heading: "\u0424\u0430\u0433\u043E\u0446\u0438\u0442\u043E\u0437"
    text: "\u2022 \u041A\u043B\u0435\u0442\u043A\u0430 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0451\u0442
      \u0447\u0443\u0436\u0435\u0440\u043E\u0434\u043D\u044B\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B.\n\u2022
      \u041C\u0435\u043C\u0431\u0440\u0430\u043D\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
      \u043F\u0441\u0435\u0432\u0434\u043E\u043F\u043E\u0434\u0438\u0438 \u0438 \u043E\u043A\u0440\u0443\u0436\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u0438\u0446\u0443.\n\u2022 \u041F\u043E\u0441\u043B\u0435
      \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B
      \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442\u0441\u044F \u0432\u043D\u0443\u0442\u0440\u0438."
    visualConnection: "\u0420\u0410\u0421\u041F\u041E\u0417\u041D\u0410\u0422\u042C
      \u2192 \u041E\u041A\u0420\u0423\u0416\u0418\u0422\u042C \u2192 \u041F\u041E\u0413\u041B\u041E\u0422\u0418\u0422\u042C"
  - heading: "\u041A\u043E\u043D\u0442\u0435\u043A\u0441\u0442 \u0437\u0430\u0449\u0438\u0442\u044B"
    text: "\u2022 \u042D\u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432
      \u0432\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B.\n\u2022
      \u041D\u0435 \u0432\u0441\u0435 \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u044B
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E \u0444\u0430\u0433\u043E\u0446\u0438\u0442\u0438\u0440\u0443\u044E\u0442.\n\u2022
      \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0432\u0438\u0440\u0443\u0441\u043D\u044B\u0439
      \u0438\u043C\u043C\u0443\u043D\u0438\u0442\u0435\u0442 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B."
    visualConnection: "\u0412\u0420\u041E\u0416\u0414\u0401\u041D\u041D\u0410\u042F
      \u0418 \u0410\u0414\u0410\u041F\u0422\u0418\u0412\u041D\u0410\u042F \u0417\u0410\u0429\u0418\u0422\u0410"
