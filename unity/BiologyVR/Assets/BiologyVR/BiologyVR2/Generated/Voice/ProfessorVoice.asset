  - text: "\u0412\u0438\u0434\u0438\u0448\u044C \u043A\u043E\u043B\u044C\u0446\u0430
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438? \u0421\u043E\u0436\u043C\u0438
      \u0441\u043E\u0441\u0443\u0434 \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438
      \u2014 \u0438 \u0441\u043B\u0435\u0434\u0438 \u0437\u0430 \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A\u043E\u043C
      \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435."
    clip: {fileID: 8300000, guid: 0ed3e1255b8837e41bff93dc81699d48, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u0440\u043E\u0441\u0432\u0435\u0442 \u043C\u0435\u043D\u044C\u0448\u0435
      \u0432\u0441\u0435\u0433\u043E \u043D\u0430 \u043F\u044F\u0442\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C, \u0430 \u043A\u0440\u043E\u0432\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0432\u0434\u0432\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0435! \u0418
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u0440\u043E\u0441\u043B\u043E:
      \u0441\u0435\u0440\u0434\u0446\u0443 \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    clip: {fileID: 8300000, guid: ad77e66ad943d664e988acc5a4173d83, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u043E\u0442 \u0442\u0430\u043A \u043C\u044B\u0448\u0446\u044B \u0441\u043E\u0441\u0443\u0434\u043E\u0432
      \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442 \u043A\u0440\u043E\u0432\u044C
      \u043C\u0435\u0436\u0434\u0443 \u043E\u0440\u0433\u0430\u043D\u0430\u043C\u0438.
      \u0417\u0430\u043F\u043E\u043C\u043D\u0438 \u044D\u0442\u043E \u2014 \u0441\u043A\u043E\u0440\u043E
      \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
    clip: {fileID: 8300000, guid: 7e30e16d171984f4397fa111004758bc, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0422\u0440\u0435\u0432\u043E\u0433\u0430! \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u0441\u043E\u0441\u0443\u0434 \u0441\u0436\u0430\u043B\u0441\u044F \u0432
      \u0441\u043F\u0430\u0437\u043C\u0435 \u2014 \u043A\u0440\u043E\u0432\u0438
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442.
      \u0420\u0430\u0441\u0448\u0438\u0440\u044F\u0439 \u0435\u0433\u043E \u043F\u043E\u043B\u0435\u043C
      \u0438 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0439\u0441\u044F \u0441\u043A\u0432\u043E\u0437\u044C
      \u043A\u043E\u043B\u044C\u0446\u0430!"
    clip: {fileID: 8300000, guid: 327238bfb0ee15b448f28f4d9e1575da, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0422\u043A\u0430\u043D\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E. \u041D\u0438\u0447\u0435\u0433\u043E \u2014
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0435\u0449\u0451 \u0440\u0430\u0437.
      \u0420\u0430\u0441\u0448\u0438\u0440\u044F\u0439 \u0441\u043E\u0441\u0443\u0434
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435!"
    clip: {fileID: 8300000, guid: 2ba1390048526cf4a8803d010041cddd, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0421\u043F\u0430\u0437\u043C \u043F\u0440\u043E\u0448\u0451\u043B, \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D! \u0422\u044B
      \u0434\u0435\u0440\u0436\u0430\u043B \u0441\u043E\u0441\u0443\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u2014 \u0442\u043A\u0430\u043D\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434."
    clip: {fileID: 8300000, guid: c7dd767a007108e48a447c7b67b13170, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0411\u043B\u0435\u0441\u0442\u044F\u0449\u0435! \u0422\u0440\u0438 \u0437\u0432\u0435\u0437\u0434\u044B.
      \u0422\u044B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043D\u0430\u043D\u043E\u043F\u0438\u043B\u043E\u0442."
    clip: {fileID: 8300000, guid: e83ed4469fd3b96409eb7b7197a1eb93, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0449\u0451
      \u0440\u0430\u0437 \u0438 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0435
      \u0437\u0432\u0451\u0437\u0434\u044B."
    clip: {fileID: 8300000, guid: 83d811245063e6248a099a62ab7b1924, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u0435\u0440\u043D\u043E \u2014 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u0440\u0430\u0441\u0442\u0451\u0442 \u043E\u0447\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E."
    clip: {fileID: 8300000, guid: 93d6caddd44608247bd69274f722e7c9, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C: \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u2014 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435,
      \u043E\u043D\u043E \u0440\u0430\u0441\u0442\u0451\u0442 \u043E\u0447\u0435\u043D\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E."
    clip: {fileID: 8300000, guid: 3bd815e3a7d67b844a7a2639c7847173, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E
      \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A \u0441\u043B\u0430\u0431\u0435\u0435\u0442
      \u2014 \u0442\u0430\u043C \u0431\u043B\u044F\u0448\u043A\u0430. \u042D\u0442\u043E
      \u0433\u043B\u0430\u0432\u0430 2."
    clip: {fileID: 8300000, guid: d07447f9da1332d4d9456cea2b28a121, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u043B\u0430\u0432\u0430\u0439 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0445\u043E\u0447\u0435\u0448\u044C. \u0421\u043A\u0430\u043D\u0435\u0440
      \u0438 \u041F\u0440\u0438\u0442\u044F\u0436\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442."
    clip: {fileID: 8300000, guid: 09993e43865afe64cbece6c54a78d4e3, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041C\u044B \u043D\u0438\u0436\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E.
      \u041F\u043E\u0434\u043D\u0438\u043C\u0438 \u043B\u0435\u0432\u0443\u044E \u0440\u0443\u043A\u0443:
      \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A \u0437\u0434\u0435\u0441\u044C
      \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u043E\u0440\u043C\u044B."
    clip: {fileID: 8300000, guid: 3eaf80929b1f0ed40a8ee87435edc5ef, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041C\u044B \u043D\u0438\u0436\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E.
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u044C
      \u0432\u043D\u0438\u0437\u0443 \u0441\u043B\u0435\u0432\u0430: \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A
      \u0437\u0434\u0435\u0441\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u043E\u0440\u043C\u044B."
    clip: {fileID: 8300000, guid: 82b562d0566d36e4e980ac9e8213f2ae, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0427\u0442\u043E-\u0442\u043E \u0441\u0443\u0436\u0430\u0435\u0442 \u0430\u0440\u0442\u0435\u0440\u0438\u044E.
      \u041F\u043B\u044B\u0432\u0438 \u0432\u043F\u0435\u0440\u0451\u0434, \u043D\u0430\u0439\u0434\u0438
      \u044D\u0442\u043E \u0438 \u043E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439."
    clip: {fileID: 8300000, guid: 614bfef2fb577cd40a912231aa79385a, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u043E\u0442 \u043E\u043D\u043E: \u0441\u0442\u0435\u043D\u043A\u0430
      \u0432\u0437\u0434\u0443\u043B\u0430\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u044C
      \u0441\u043E\u0441\u0443\u0434\u0430. \u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439!"
    clip: {fileID: 8300000, guid: 987291182d0b0934ba8b386ee68f1085, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u0430 \u0431\u043B\u044F\u0448\u043A\u0435 \u0441\u0438\u0434\u0438\u0442
      \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430.
      \u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439 \u0438 \u0435\u0451."
    clip: {fileID: 8300000, guid: bda8b57e01b09f248a40415a9852b117, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0421\u0430\u043C\u043E\u0435 \u043E\u043F\u0430\u0441\u043D\u043E\u0435
      \u0432 \u0431\u043B\u044F\u0448\u043A\u0435 \u2014 \u043D\u0435 \u0440\u0430\u0437\u043C\u0435\u0440.
      \u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E?"
    clip: {fileID: 8300000, guid: 26767223d63f1d548bd3c57820099b03, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u0435\u0440\u043D\u043E. \u041D\u0430 \u0440\u0430\u0437\u0440\u044B\u0432\u0435
      \u0441\u0440\u0430\u0437\u0443 \u043D\u0430\u0447\u043D\u0451\u0442 \u0440\u0430\u0441\u0442\u0438
      \u0442\u0440\u043E\u043C\u0431 \u2014 \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043F\u043E\u043A\u0440\u044B\u0448\u043A\u0443 \u043D\u0430\u0434\u043E \u0431\u0435\u0440\u0435\u0447\u044C."
    clip: {fileID: 8300000, guid: 35fcef8bd3a808446afe5be259fe45e9, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u0435\u0442 \u2014 \u043A\u0440\u043E\u0432\u044C \u0438\u0437
      \u0441\u043E\u0441\u0443\u0434\u0430 \u043D\u0435 \u0432\u044B\u0439\u0434\u0435\u0442.
      \u0410 \u0432\u043E\u0442 \u043D\u0430 \u0440\u0430\u0437\u0440\u044B\u0432\u0435
      \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442 \u0442\u0440\u043E\u043C\u0431.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u043A\u0440\u044B\u0448\u043A\u0443
      \u043D\u0430\u0434\u043E \u0431\u0435\u0440\u0435\u0447\u044C."
    clip: {fileID: 8300000, guid: 149a5830ced041c44b803e995c4ef610, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0417\u0430\u043A\u0440\u0435\u043F\u0438\u0441\u044C: \u043F\u0440\u0438\u0446\u0435\u043F\u0438\u0441\u044C
      \u044F\u043A\u043E\u0440\u0435\u043C \u043A \u043C\u0430\u044F\u043A\u0443
      \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u043B\u044F\u0448\u043A\u0438."
    clip: {fileID: 8300000, guid: 83d2f21ba56137a4082b65ff4c7b3533, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u043E\u0432\u044B\u0439 \u0440\u0435\u0436\u0438\u043C BioTool
      \u2014 \u0418\u043C\u043F\u0443\u043B\u044C\u0441. \u041E\u043D \u0440\u0430\u0441\u0442\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442
      \u0436\u0438\u0440."
    clip: {fileID: 8300000, guid: f43a6be05887f9044884ada863abd764, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u043E \u043F\u043E\u043A\u0440\u044B\u0448\u043A\u0430 \u0442\u043E\u043D\u043A\u0430\u044F.
      \u0421\u0442\u0440\u0435\u043B\u044F\u0439, \u043A\u043E\u0433\u0434\u0430
      \u043A\u043E\u043B\u044C\u0446\u043E \u0437\u0435\u043B\u0451\u043D\u043E\u0435.
      \u0416\u0451\u043B\u0442\u043E\u0435 \u2014 \u0441\u0435\u0439\u0447\u0430\u0441
      \u043F\u0440\u0438\u0434\u0451\u0442 \u043F\u0443\u043B\u044C\u0441\u043E\u0432\u0430\u044F
      \u0432\u043E\u043B\u043D\u0430 \u0438 \u0437\u0430\u043A\u0440\u043E\u0435\u0442
      \u043E\u043A\u043D\u043E."
    clip: {fileID: 8300000, guid: ffd6c9dba2e0fd446b805717124a5a06, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041E\u043A\u043D\u043E \u0431\u044B\u043B\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E
      \u2014 \u0418\u043C\u043F\u0443\u043B\u044C\u0441 \u0443\u0434\u0430\u0440\u0438\u043B
      \u0432 \u043F\u043E\u043A\u0440\u044B\u0448\u043A\u0443! \u0414\u043E\u0436\u0434\u0438\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0439\u0434\u0451\u0442 \u043F\u0443\u043B\u044C\u0441\u043E\u0432\u0430\u044F
      \u0432\u043E\u043B\u043D\u0430."
    clip: {fileID: 8300000, guid: 782fd2c574106e943baea00a53b45cee, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u043E\u043A\u0440\u044B\u0448\u043A\u0430 \u0442\u0440\u0435\u0449\u0438\u0442!
      \u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0430
      \u2014 \u0438 \u043E\u043D\u0430 \u043B\u043E\u043F\u043D\u0435\u0442."
    clip: {fileID: 8300000, guid: ecd32f731ee927644aa1204849f88f89, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0416\u0438\u0440 \u0440\u0430\u0441\u0442\u043E\u043F\u043B\u0435\u043D,
      \u043F\u0440\u043E\u0441\u0432\u0435\u0442 \u043F\u043E\u0447\u0442\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D!
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A \u0432\u044B\u0440\u043E\u0441
      \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A."
    clip: {fileID: 8300000, guid: a75a3fefcdfa8c24da1a22de4ea1321a, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0421\u0442\u043E\u043F\u2026 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043F\u043E\u0434\u0441\u043A\u043E\u0447\u0438\u043B\u043E. \u0421\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u044E\u044E \u0431\u043B\u044F\u0448\u043A\u0443!"
    clip: {fileID: 8300000, guid: ff693f9e187e6d34f912c06a10a16c3e, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u043E\u043A\u0440\u044B\u0448\u043A\u0430 \u043B\u043E\u043F\u043D\u0443\u043B\u0430!"
    clip: {fileID: 8300000, guid: d3e049133b6d0084da0b98b7a820051c, type: 3}
    fps: 50
    open: 0000001d88cee3c6a88e8c7f727ba8c2c1ffcac1b8887a5e4a849c918e8f97a4bedae7fcdeb084746b6975717776797567523b2b1f16100b08
