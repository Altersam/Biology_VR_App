  id: rbc
  displayName: "\u042D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442"
  requiredForCompletion: 1
  professorComment: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430
    \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u044F \u0441 \u043E\u0431\u0435\u0438\u0445
    \u0441\u0442\u043E\u0440\u043E\u043D. \u042D\u0442\u0430 \u0444\u043E\u0440\u043C\u0430
    \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043A\u043B\u0435\u0442\u043A\u0435
    \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0433\u0430\u0437\u0430\u043C\u0438."
  pages:
  - heading: "\u0421\u0442\u0440\u043E\u0435\u043D\u0438\u0435"
    text: "\u2022 \u0417\u0440\u0435\u043B\u044B\u0439 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043D\u0435 \u0438\u043C\u0435\u0435\u0442
      \u044F\u0434\u0440\u0430.\n\u2022 \u0414\u0432\u043E\u044F\u043A\u043E\u0432\u043E\u0433\u043D\u0443\u0442\u044B\u0439
      \u0434\u0438\u0441\u043A \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043E\u0431\u043C\u0435\u043D\u0430.\n\u2022
      \u0413\u0438\u0431\u043A\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0443\u0437\u043A\u0438\u0435 \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u044B."
    visualConnection: "\u0424\u041E\u0420\u041C\u0410 \u2192 \u041F\u041E\u0412\u0415\u0420\u0425\u041D\u041E\u0421\u0422\u042C
      \u2192 \u041E\u0411\u041C\u0415\u041D"
  - heading: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430"
    text: "\u2022 \u042D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442
      O\u2082 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0433\u0435\u043C\u043E\u0433\u043B\u043E\u0431\u0438\u043D\u0443.\n\u2022
      \u0412 \u043B\u0451\u0433\u043A\u0438\u0445 O\u2082 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 Hb.\n\u2022 \u0412 \u0442\u043A\u0430\u043D\u044F\u0445 \u0441\u0432\u044F\u0437\u044C
      \u043E\u0431\u0440\u0430\u0442\u0438\u043C\u043E \u043E\u0441\u043B\u0430\u0431\u0435\u0432\u0430\u0435\u0442."
    visualConnection: "\u041B\u0401\u0413\u041A\u0418\u0415 \u2192 Hb\u2013O\u2082
      \u2192 \u0422\u041A\u0410\u041D\u0418"
  - heading: "\u0421\u0432\u044F\u0437\u044C \u0441 \u0433\u0430\u0437\u043E\u043E\u0431\u043C\u0435\u043D\u043E\u043C"
    text: "\u2022 \u042D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
      \u0438 \u0432 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0435 \u0447\u0430\u0441\u0442\u0438
      CO\u2082.\n\u2022 \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      CO\u2082 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043A\u0430\u043A HCO\u2083\u207B.\n\u2022 Hb, \u0433\u0435\u043C \u0438 O\u2082
      \u0440\u044F\u0434\u043E\u043C \u2014 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u0435
      \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438."
    visualConnection: "\u0422\u041A\u0410\u041D\u0418 \u2192 CO\u2082 / HCO\u2083\u207B
      \u2192 \u041B\u0401\u0413\u041A\u0418\u0415"
