  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: plasma
  m_EditorClassIdentifier: 
  id: plasma
  displayName: "\u041F\u043B\u0430\u0437\u043C\u0430 \u043A\u0440\u043E\u0432\u0438"
  requiredForCompletion: 1
  professorComment: "\u041F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439
    \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
    \u0441\u0440\u0435\u0434\u044B, \u0430 \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F
    \u043A\u043B\u0435\u0442\u043A\u0430. \u0418\u043C\u0435\u043D\u043D\u043E \u0432
    \u044D\u0442\u043E\u0439 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044E\u0442
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0451\u043D\u043D\u044B\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430."
  pages:
  - heading: "\u0416\u0438\u0434\u043A\u0430\u044F \u0441\u0440\u0435\u0434\u0430"
    text: "\u2022 \u041F\u043B\u0430\u0437\u043C\u0430 \u2014 \u0436\u0438\u0434\u043A\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u043A\u0440\u043E\u0432\u0438, \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0432\u043E\u0434\u0430.\n\u2022 \u0412 \u043D\u0435\u0439 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F
      \u0444\u043E\u0440\u043C\u0435\u043D\u043D\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B.\n\u2022
      \u041E\u043D\u0430 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0451\u043D\u043D\u044B\u0435
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430."
    visualConnection: "\u041F\u041B\u0410\u0417\u041C\u0410 = \u0421\u0420\u0415\u0414\u0410
      \u0422\u0420\u0410\u041D\u0421\u041F\u041E\u0420\u0422\u0410"
  - heading: "\u0422\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442 \u0432\u0435\u0449\u0435\u0441\u0442\u0432"
    text: "\u2022 \u041F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0438\u0434\u0443\u0442 \u043A
      \u0442\u043A\u0430\u043D\u044F\u043C.\n\u2022 \u041F\u0440\u043E\u0434\u0443\u043A\u0442\u044B
      \u043E\u0431\u043C\u0435\u043D\u0430 \u2014 \u043A \u043E\u0440\u0433\u0430\u043D\u0430\u043C
      \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u0438\u044F.\n\u2022 \u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0442\u044B
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u0432\u043E\u0434\u043D\u044B\u0439
      \u0438 \u0438\u043E\u043D\u043D\u044B\u0439 \u0431\u0430\u043B\u0430\u043D\u0441."
    visualConnection: "\u041F\u0418\u0422\u0410\u041D\u0418\u0415 \xB7 \u042D\u041B\u0415\u041A\u0422\u0420\u041E\u041B\u0418\u0422\u042B
      \xB7 \u041E\u0411\u041C\u0415\u041D"
  - heading: "\u0411\u0435\u043B\u043A\u0438 \u043F\u043B\u0430\u0437\u043C\u044B"
    text: "\u2022 \u0410\u043B\u044C\u0431\u0443\u043C\u0438\u043D \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u0432\u043E\u0434\u0443 \u0438 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430.\n\u2022 \u0413\u043B\u043E\u0431\u0443\u043B\u0438\u043D\u044B
      \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442 \u0432 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0435
      \u0438 \u0437\u0430\u0449\u0438\u0442\u0435.\n\u2022 \u0424\u0438\u0431\u0440\u0438\u043D\u043E\u0433\u0435\u043D
      \u2014 \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A
      \u0444\u0438\u0431\u0440\u0438\u043D\u0430."
    visualConnection: "\u0410\u041B\u042C\u0411\u0423\u041C\u0418\u041D \xB7 \u0413\u041B\u041E\u0411\u0423\u041B\u0418\u041D\u042B
      \xB7 \u0424\u0418\u0411\u0420\u0418\u041D\u041E\u0413\u0415\u041D"
  - heading: "\u0421\u0432\u044F\u0437\u044C \u0441 \u043A\u043B\u0435\u0442\u043A\u0430\u043C\u0438"
    text: "\u2022 \u041F\u043B\u0430\u0437\u043C\u0430 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
      \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u0439 \u0438 \u043E\u0431\u0449\u0438\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430.\n\u2022
      \u0427\u0430\u0441\u0442\u044C \u0433\u0430\u0437\u043E\u0432 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430;
      HCO\u2083\u207B \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0432 \u043F\u043B\u0430\u0437\u043C\u0435.\n\u2022 \u0412\u0438\u0434\u0438\u043C\u044B\u0435
      \u0447\u0430\u0441\u0442\u0438\u0446\u044B \u2014 \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0435
      \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0437\u0446\u044B."
    visualConnection: "\u041A\u041B\u0415\u0422\u041A\u0418 \u2194 \u041F\u041B\u0410\u0417\u041C\u0410
      \u2194 \u041E\u0420\u0413\u0410\u041D\u042B"
