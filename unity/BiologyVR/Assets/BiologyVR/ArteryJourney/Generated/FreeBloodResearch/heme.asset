  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: heme
  m_EditorClassIdentifier: 
  id: heme
  displayName: "\u0413\u0435\u043C \u0438 \u0436\u0435\u043B\u0435\u0437\u043E Fe\xB2\u207A"
  requiredForCompletion: 0
  professorComment: "\u0420\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438 \u0446\u0435\u043D\u0442\u0440
    \u0433\u0435\u043C\u0430. \u0417\u0434\u0435\u0441\u044C \u0432\u0430\u0436\u043D\u043E
    \u0436\u0435\u043B\u0435\u0437\u043E \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435
    \u0431\u0435\u043B\u043A\u0430, \u0430 \u043D\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439
    \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u0442\u043E\u043C \u0432 \u043F\u043E\u0442\u043E\u043A\u0435."
  pages:
  - heading: "\u0426\u0435\u043D\u0442\u0440 \u0433\u0435\u043C\u0430"
    text: "\u2022 \u0413\u0435\u043C \u2014 \u043F\u043E\u0440\u0444\u0438\u0440\u0438\u043D\u043E\u0432\u043E\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E \u0441 Fe\xB2\u207A \u0432 \u0446\u0435\u043D\u0442\u0440\u0435.\n\u2022
      \u041E\u043D \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432
      \u0433\u0435\u043C\u043E\u0433\u043B\u043E\u0431\u0438\u043D\u0430.\n\u2022
      O\u2082 \u043E\u0431\u0440\u0430\u0442\u0438\u043C\u043E \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u044D\u0442\u0438\u043C \u0446\u0435\u043D\u0442\u0440\u043E\u043C."
    visualConnection: "Hb \u2192 \u0413\u0415\u041C \u2192 Fe\xB2\u207A \u2194 O\u2082"
  - heading: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0441\u0442\u0435\u043F\u0435\u043D\u044C
      \u043E\u043A\u0438\u0441\u043B\u0435\u043D\u0438\u044F \u0432\u0430\u0436\u043D\u0430"
    text: "\u2022 \u0414\u043B\u044F \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043D\u0438\u044F O\u2082 \u043D\u0443\u0436\u0435\u043D
      Fe\xB2\u207A.\n\u2022 \u041E\u043A\u0438\u0441\u043B\u0435\u043D\u0438\u0435
      \u0434\u043E Fe\xB3\u207A \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
      \u043C\u0435\u0442\u0433\u0435\u043C\u043E\u0433\u043B\u043E\u0431\u0438\u043D.\n\u2022
      \u0422\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u0442\u0440 \u043D\u0435
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 O\u2082 \u043E\u0431\u044B\u0447\u043D\u044B\u043C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C."
    visualConnection: "Fe\xB2\u207A: \u0421\u0412\u042F\u0417\u042B\u0412\u0410\u041D\u0418\u0415
      O\u2082"
