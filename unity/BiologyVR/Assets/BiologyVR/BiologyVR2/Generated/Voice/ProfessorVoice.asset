    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u0435\u0442 \u2014 \u043F\u043E \u0448\u0438\u043F\u0430\u043C-\u0430\u043D\u0442\u0438\u0433\u0435\u043D\u0430\u043C.
      \u041A \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0438\u0437 \u043D\u0438\u0445
      \u0438\u043C\u043C\u0443\u043D\u0438\u0442\u0435\u0442 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u043E\u0439 \u043A\u043B\u044E\u0447 \u2014 \u0430\u043D\u0442\u0438\u0442\u0435\u043B\u043E."
    clip: {fileID: 8300000, guid: 21e1d3964aafdd641ba3d9a6094fc3e5, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0421\u043A\u0430\u043D\u0435\u0440 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B
      \u0430\u043D\u0442\u0438\u0433\u0435\u043D \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0430\u043D\u0442\u0438\u0442\u0435\u043B\u0430.
      \u0414\u0435\u0440\u0436\u0438 \u043B\u0435\u0432\u044B\u0439 \u043A\u0443\u0440\u043E\u043A
      \u043D\u0430 \u0432\u0438\u0440\u0443\u0441\u0435 \u2014 \u0438 \u043F\u043E\u043C\u0435\u0442\u044C
      \u0435\u0433\u043E."
    clip: {fileID: 8300000, guid: 9113322fc37982a4caaf8233c223d346, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u043E\u0434\u043E\u0441\u043F\u0435\u043B\u0438 \u043C\u0430\u043A\u0440\u043E\u0444\u0430\u0433\u0438
      \u2014 \u043A\u043B\u0435\u0442\u043A\u0438-\u043F\u043E\u0436\u0438\u0440\u0430\u0442\u0435\u043B\u0438.
      \u0423\u043A\u0430\u0436\u0438 \u0438\u043C \u0446\u0435\u043B\u044C \u2014
      \u044D\u0442\u043E \u0421\u0438\u0433\u043D\u0430\u043B."
    clip: {fileID: 8300000, guid: bfde4c5b4eed25740aa7585d1558dcfb, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u043E\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0440\u0443\u0441
      \u0441\u044A\u0435\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u0440\u0430\u0437\u044B
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u2014 \u044D\u0442\u043E \u043E\u043F\u0441\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F.
      \u0410 \u043D\u0435\u043F\u043E\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439
      \u043C\u043E\u0436\u0435\u0442 \u0438 \u0432\u044B\u0440\u0432\u0430\u0442\u044C\u0441\u044F."
    clip: {fileID: 8300000, guid: 2b391fbc8bdfec94dbe2da4e28506420, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430.
      \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0439\u0434\u0451\u0442 \u0432\u043E\u043B\u043D\u0430!
      \u041B\u0435\u0432\u0430\u044F \u0440\u0443\u043A\u0430 \u2014 \u043C\u0435\u0442\u0438\u0442\u044C,
      \u043F\u0440\u0430\u0432\u0430\u044F \u2014 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u043C\u0430\u043A\u0440\u043E\u0444\u0430\u0433\u043E\u0432. \u041D\u0435
      \u0434\u0430\u0439 \u0438\u043C \u0441\u0435\u0441\u0442\u044C \u043D\u0430
      \u0441\u0442\u0435\u043D\u043A\u0443!"
    clip: {fileID: 8300000, guid: 03d2942b88aaad847a57814992dc18a2, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u043E\u043B\u043D\u0430 \u043E\u0442\u0431\u0438\u0442\u0430! \u0421\u0435\u0440\u0434\u0446\u0435
      \u0431\u044C\u0451\u0442\u0441\u044F \u0432\u0441\u0451 \u0447\u0430\u0449\u0435
      \u2014 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C \u043C\u043E\u0431\u0438\u043B\u0438\u0437\u0443\u0435\u0442\u0441\u044F.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0431\u0443\u0434\u0435\u0442
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
    clip: {fileID: 8300000, guid: b716fd9fbb2b24d48942bce0a8eac727, type: 3}
