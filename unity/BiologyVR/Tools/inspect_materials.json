{"skip_refresh":true,"code":"return Newtonsoft.Json.JsonConvert.SerializeObject(UnityEngine.Resources.FindObjectsOfTypeAll<UnityEngine.Material>().Where(m=>m.name==\"HD_RBC\"||m.name==\"HD_Wall\"||m.name==\"HD_Pearl\").Select(m=>new {name=m.name,shader=m.shader.name,color=m.GetColor(\"_BaseColor\").ToString(),metal=m.GetFloat(\"_Metallic\"),smooth=m.GetFloat(\"_Smoothness\"),pulse=m.GetFloat(\"_PulseAmplitude\")}).ToArray());"}
