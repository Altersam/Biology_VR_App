  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: hemoglobin
  m_EditorClassIdentifier: 
  id: hemoglobin
  displayName: "\u0413\u0435\u043C\u043E\u0433\u043B\u043E\u0431\u0438\u043D"
  requiredForCompletion: 0
  professorComment: "\u042D\u0442\u0430 \u043C\u043E\u0434\u0435\u043B\u044C \u0441\u0432\u044F\u0437\u0430\u043D\u0430
    \u0441 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u043C. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438,
    \u0433\u0434\u0435 \u0431\u0435\u043B\u043E\u043A \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434, \u0430 \u043D\u0435 \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0439
    \u0435\u0433\u043E \u043A\u0430\u043A \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E
    \u043A\u043B\u0435\u0442\u043A\u0443."
  pages:
  - heading: "\u0421\u0432\u044F\u0437\u044C \u0441 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u043C"
    text: "\u2022 \u0413\u0435\u043C\u043E\u0433\u043B\u043E\u0431\u0438\u043D \u2014
      \u0431\u0435\u043B\u043E\u043A \u0432\u043D\u0443\u0442\u0440\u0438 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u0430.\n\u2022
      \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F
      \u2014 \u043E\u0431\u0440\u0430\u0442\u0438\u043C\u043E\u0435 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043D\u0438\u0435
      O\u2082.\n\u2022 \u041C\u043E\u0434\u0435\u043B\u044C \u0437\u0434\u0435\u0441\u044C
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0430 \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F."
    visualConnection: "\u042D\u0420\u0418\u0422\u0420\u041E\u0426\u0418\u0422 \u2192
      Hb \u2192 O\u2082 \u2192 \u0422\u041A\u0410\u041D\u0418"
  - heading: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0430
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043D\u0438\u044F"
    text: "\u2022 \u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0439
      HbA \u0438\u043C\u0435\u0435\u0442 \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u044B.\n\u2022
      \u041A\u0430\u0436\u0434\u0430\u044F \u043D\u0435\u0441\u0451\u0442 \u0433\u0435\u043C
      \u0441 Fe\xB2\u207A.\n\u2022 \u041E\u0434\u043D\u0430 \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u0430
      Hb \u043C\u043E\u0436\u0435\u0442 \u0441\u0432\u044F\u0437\u0430\u0442\u044C
      \u0447\u0435\u0442\u044B\u0440\u0435 O\u2082."
    visualConnection: "4 \u0421\u0423\u0411\u042A\u0415\u0414\u0418\u041D\u0418\u0426\u042B
      \xB7 4 \u0413\u0415\u041C\u0410 \xB7 4 O\u2082"
  - heading: "\u041E\u0431\u0440\u0430\u0442\u0438\u043C\u044B\u0439 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442"
    text: "\u2022 \u0412 \u043B\u0451\u0433\u043A\u0438\u0445 Hb \u043D\u0430\u0441\u044B\u0449\u0430\u0435\u0442\u0441\u044F
      O\u2082.\n\u2022 \u0412 \u0442\u043A\u0430\u043D\u044F\u0445 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434
      \u043E\u0442\u0434\u0430\u0451\u0442\u0441\u044F \u043F\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C
      \u0441\u0440\u0435\u0434\u044B.\n\u2022 \u0427\u0430\u0441\u0442\u044C CO\u2082
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0431\u0435\u043B\u043A\u043E\u0432\u043E\u0439
      \u0447\u0430\u0441\u0442\u044C\u044E Hb."
    visualConnection: "Hb + O\u2082 \u21C4 HbO\u2082"
