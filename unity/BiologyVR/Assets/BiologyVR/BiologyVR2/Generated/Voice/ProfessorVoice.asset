  - text: "\u0421\u043C\u043E\u0442\u0440\u0438: \u043D\u0430 \u0440\u0430\u0437\u0440\u044B\u0432
      \u0441\u043B\u0435\u0442\u0430\u044E\u0442\u0441\u044F \u0442\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442\u044B.
      \u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439, \u0447\u0442\u043E
      \u0442\u0430\u043C \u0440\u0430\u0441\u0442\u0451\u0442!"
    clip: {fileID: 8300000, guid: a9b793ecf8822a44abb714516995b1d4, type: 3}
