  - text: "\u041B\u0438\u0448\u043D\u0438\u0435 \u0441\u0433\u0443\u0441\u0442\u043A\u0438
      \u0441\u0443\u0436\u0430\u044E\u0442 \u0430\u0440\u0442\u0435\u0440\u0438\u044E
      \u2014 \u044D\u0442\u043E \u0442\u0440\u043E\u043C\u0431\u044B. \u0421\u0440\u0435\u0436\u044C
      \u0438\u0445 \u0418\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u043C."
    clip: {fileID: 8300000, guid: 3e09167d10765324c87a75b067ca5781, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u043E\u043A\u0440\u0443\u0433 \u0440\u0430\u043D\u044B \u2014 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445 \u043A\u043B\u0435\u0442\u043E\u043A.
      \u041F\u043E\u0437\u043E\u0432\u0438 \u043C\u0430\u043A\u0440\u043E\u0444\u0430\u0433\u043E\u0432
      \u0421\u0438\u0433\u043D\u0430\u043B\u043E\u043C."
    clip: {fileID: 8300000, guid: d370dc8aef5d3ba48b34818518630222, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0421\u0442\u0435\u043D\u043A\u0430 \u0437\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442:
      \u043A\u043B\u0435\u0442\u043A\u0438 \u0434\u0435\u043B\u044F\u0442\u0441\u044F
      \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0440\u0430\u0437\u0440\u044B\u0432,
      \u0430 \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0439 \u0444\u0438\u0431\u0440\u0438\u043D
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F."
    clip: {fileID: 8300000, guid: 62dc526ec8374ce4db9e1d6c33a365d2, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0411\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E! \u0422\u0430\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0433\u0435\u043C\u043E\u0441\u0442\u0430\u0437."
    clip: {fileID: 8300000, guid: ccf4efe5e1369e941a25721e33a5a147, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0420\u0430\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430! \u041F\u0440\u043E\u0439\u0434\u0438
      \u0435\u0449\u0451 \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0432\u0441\u0435 \u0437\u0432\u0451\u0437\u0434\u044B."
    clip: {fileID: 8300000, guid: 6bbe2128f653b3545be5fb8538d424f4, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0422\u043E\u0447\u043D\u043E. \u0422\u0440\u043E\u043C\u0431\u0438\u043D
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0444\u0438\u0431\u0440\u0438\u043D\u043E\u0433\u0435\u043D
      \u0432 \u0444\u0438\u0431\u0440\u0438\u043D."
    clip: {fileID: 8300000, guid: 83fefec05e2b4d34bb0c8324d3f58dcb, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041D\u0435\u0442: \u043D\u0438\u0442\u0438 \u0441\u0433\u0443\u0441\u0442\u043A\u0430
      \u2014 \u044D\u0442\u043E \u0444\u0438\u0431\u0440\u0438\u043D. \u0415\u0433\u043E
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0442\u0440\u043E\u043C\u0431\u0438\u043D
      \u0438\u0437 \u0444\u0438\u0431\u0440\u0438\u043D\u043E\u0433\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: 2e0f38a647c1b064a8aa1409ac72e41c, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0420\u0430\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430. \u041F\u043B\u0430\u0432\u0430\u0439
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0447\u0435\u0448\u044C."
    clip: {fileID: 8300000, guid: 13f211225e559d845aa4717a4d2e5740, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0428\u043E\u043A! \u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E \u043A\u0440\u043E\u0432\u0438. \u042F \u0432\u043B\u0438\u043B
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440 \u2014 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043C
      \u044D\u0442\u043E\u0442 \u044D\u0442\u0430\u043F \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    clip: {fileID: 8300000, guid: 05cb654a3cf291e4fb7edc3cfd5f743f, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0401\u0436\u0438\u043A! \u041F\u043E \u0431\u0440\u043E\u043D\u0435
      \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0430\u043D\u0442\u0438\u0442\u0435\u043B\u0430
      \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u044E\u0442.
      \u041D\u043E \u0434\u0435\u0440\u0436\u0438 \u043D\u0430 \u043D\u0451\u043C
      \u0441\u043A\u0430\u043D\u0435\u0440 \u2014 \u0442\u0430\u043A \u043A\u043B\u044E\u0447
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    clip: {fileID: 8300000, guid: 42dd6356eebcdff49b923e3f927e9e76, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u0430\u044F
      \u043A\u043B\u0435\u0442\u043A\u0430 \u2014 \u043D\u0430 \u043D\u0435\u0439
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0444\u043B\u0430\u0436\u043A\u043E\u0432!
      \u0422-\u043A\u0438\u043B\u043B\u0435\u0440 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B
      \u0441\u0442\u0435\u043D\u043A\u0443."
    clip: {fileID: 8300000, guid: 247b3cbd8460f954f8c14a9eb26552bb, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u043E\u0442 \u043E\u043D, \u043E\u0447\u0430\u0433 \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u0438:
      \u0441\u0442\u0435\u043D\u043A\u0430 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438
      \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0430, \u0438 \u0438\u0437 \u0435\u0451
      \u043A\u043B\u0435\u0442\u043E\u043A \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u043D\u043E\u0432\u044B\u0435 \u0432\u0438\u0440\u0443\u0441\u044B. \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
      38 \u0438 \u0440\u0430\u0441\u0442\u0451\u0442."
    clip: {fileID: 8300000, guid: 845da7855af9e2943861451053a39f22, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439 \u0440\u0430\u0437\u0434\u0443\u0442\u0443\u044E
      \u043A\u043B\u0435\u0442\u043A\u0443 \u2014 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0441 \u043D\u0435\u0439."
