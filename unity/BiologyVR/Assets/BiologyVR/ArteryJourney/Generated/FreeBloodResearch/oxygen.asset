  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: oxygen
  m_EditorClassIdentifier: 
  id: oxygen
  displayName: "\u041A\u0438\u0441\u043B\u043E\u0440\u043E\u0434 O\u2082"
  requiredForCompletion: 0
  professorComment: "\u041F\u0440\u043E\u0441\u043B\u0435\u0434\u0438 \u043F\u0443\u0442\u044C
    \u043E\u0442 \u043B\u0451\u0433\u043A\u0438\u0445 \u043A \u0442\u043A\u0430\u043D\u044F\u043C.
    \u0421\u0432\u044F\u0437\u044C \u0441 \u0433\u0435\u043C\u043E\u043C \u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0430
    \u2014 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434 \u043D\u0443\u0436\u0435\u043D
    \u043A\u043B\u0435\u0442\u043A\u0430\u043C, \u0430 \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
    \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0447\u0438\u043A\u0435
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  pages:
  - heading: "\u041F\u0443\u0442\u044C \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430"
    text: "\u2022 \u0412 \u043B\u0451\u0433\u043A\u0438\u0445 O\u2082 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0432 \u043A\u0440\u043E\u0432\u044C.\n\u2022 \u0411\u043E\u043B\u044C\u0448\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0433\u0435\u043C\u043E\u0433\u043B\u043E\u0431\u0438\u043D\u043E\u043C.\n\u2022
      \u0412 \u0442\u043A\u0430\u043D\u044F\u0445 O\u2082 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u043A\u0440\u043E\u0432\u0438 \u043A \u043A\u043B\u0435\u0442\u043A\u0430\u043C."
    visualConnection: "\u041B\u0401\u0413\u041A\u0418\u0415 \u2192 \u041A\u0420\u041E\u0412\u042C
      \u2192 \u0422\u041A\u0410\u041D\u0418"
  - heading: "\u041A\u043B\u0435\u0442\u043E\u0447\u043D\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435"
    text: "\u2022 O\u2082 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
      \u0432 \u0430\u044D\u0440\u043E\u0431\u043D\u043E\u043C \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438.\n\u2022 \u041F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
      \u0432 \u0442\u043A\u0430\u043D\u044F\u0445 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u0433\u0440\u0430\u0434\u0438\u0435\u043D\u0442 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430.\n\u2022
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      O\u2082 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430 \u0432
      \u043F\u043B\u0430\u0437\u043C\u0435."
    visualConnection: "O\u2082 \u2192 \u041A\u041B\u0415\u0422\u041E\u0427\u041D\u041E\u0415
      \u0414\u042B\u0425\u0410\u041D\u0418\u0415 \u2192 \u042D\u041D\u0415\u0420\u0413\u0418\u042F"
  - heading: "\u0423\u0447\u0435\u0431\u043D\u0430\u044F \u043C\u043E\u0434\u0435\u043B\u044C
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043D\u0438\u044F"
    text: "\u2022 \u041C\u043E\u0434\u0435\u043B\u044C O\u2082 \u043C\u043E\u0436\u043D\u043E
      \u0432\u0437\u044F\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043A \u0433\u0435\u043C\u0443.\n\u2022
      \u042D\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E\u0431\u0440\u0430\u0442\u0438\u043C\u043E\u0441\u0442\u044C \u0441\u0432\u044F\u0437\u0438
      \u0441 Fe\xB2\u207A.\n\u2022 \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u043C\u043E\u043B\u0435\u043A\u0443\u043B
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u044B \u0443\u0441\u043B\u043E\u0432\u043D\u043E."
    visualConnection: "Fe\xB2\u207A + O\u2082 \u21C4 Fe\xB2\u207A\u2013O\u2082"
