  - text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0439\u0434\u0438 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430.
      \u0411\u0435\u043B\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430, \u043A\u0440\u0443\u043F\u043D\u0435\u0435
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445. \u0418\u0445 \u0441\u043E\u0432\u0441\u0435\u043C
      \u043C\u0430\u043B\u043E."
    clip: {fileID: 8300000, guid: 30354a6b0c461134893efa3899104b65, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u2014 \u0441\u0430\u043C\u044B\u0439
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439. \u0418\u0449\u0438
      \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0438."
    clip: {fileID: 8300000, guid: 8490dd8fa5bbc694cbaf26c3934ad40d, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0422\u044B \u0431\u044B\u043B \u043F\u0440\u0430\u0432: \u043D\u0430
      \u043E\u0434\u0438\u043D \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442 \u0437\u0434\u0435\u0441\u044C
      \u0441\u043E\u0442\u043D\u0438 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432!"
    clip: {fileID: 8300000, guid: ce89568388df3d7469b16bc314518848, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u0438\u0434\u0438\u0448\u044C? \u041D\u0430 \u043E\u0434\u0438\u043D
      \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442 \u0437\u0434\u0435\u0441\u044C
      \u0441\u043E\u0442\u043D\u0438 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432."
    clip: {fileID: 8300000, guid: 95941b18e5872d34c957f5ad97d4d168, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0410 \u0447\u0442\u043E \u0436\u0435 \u043C\u0435\u0436\u0434\u0443
      \u043A\u043B\u0435\u0442\u043A\u0430\u043C\u0438? \u041D\u0430\u043F\u0440\u0430\u0432\u044C
      \u0441\u043A\u0430\u043D\u0435\u0440 \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438."
    clip: {fileID: 8300000, guid: e8cbff7cb12964f4db44898d3ba89cf6, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u043A\u043B\u044E\u0447\u0430\u044E \u0442\u0432\u043E\u0451 \u041F\u0440\u0438\u0442\u044F\u0436\u0435\u043D\u0438\u0435.
      \u0412\u043E\u0437\u044C\u043C\u0438 \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u0446\u0443
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u0438\u0434\u0430 \u2014
      \u0434\u043B\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
    clip: {fileID: 8300000, guid: c71b22e652846994c9c5109d876be025, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041E\u0431\u0440\u0430\u0437\u0446\u044B \u0443 \u043D\u0430\u0441.
      \u041A\u0440\u043E\u0432\u044C \u2014 \u044D\u0442\u043E \u043A\u043B\u0435\u0442\u043A\u0438
      \u0438 \u043F\u043B\u0430\u0437\u043C\u0430. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u043D\u0430 \u0441\u0430\u043C
      \u0441\u043E\u0441\u0443\u0434."
    clip: {fileID: 8300000, guid: 1644f909c3c8aa046a37c20fffa14fb9, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0414\u0435\u0440\u0436\u0438 \u043A\u0443\u0440\u043E\u043A, \u043F\u043E\u043A\u0430
      \u043A\u043E\u043B\u044C\u0446\u043E \u0441\u043A\u0430\u043D\u0435\u0440\u0430
      \u043D\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F."
    clip: {fileID: 8300000, guid: 7cda86770e4033b4f85bf156d9a78603, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0412\u0438\u0434\u0438\u0448\u044C \u0441\u0438\u044F\u044E\u0449\u0438\u0439
      \u043C\u0430\u044F\u043A \u0443 \u0441\u0442\u0435\u043D\u043A\u0438? \u041F\u043E\u0434\u043F\u043B\u044B\u0432\u0438
      \u043A \u043D\u0435\u043C\u0443 \u0438 \u043F\u0440\u0438\u0446\u0435\u043F\u0438\u0441\u044C
      \u044F\u043A\u043E\u0440\u0435\u043C."
    clip: {fileID: 8300000, guid: 9c64db4913ef5464cbb35e4c367b12e2, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u042F \u0432\u044B\u0440\u0435\u0437\u0430\u043B \u0434\u043B\u044F \u0442\u0435\u0431\u044F
      \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u0441\u0442\u0435\u043D\u043A\u0438.
      \u0421\u0442\u0435\u043D\u043A\u0430 \u0430\u0440\u0442\u0435\u0440\u0438\u0438
      \u2014 \u0442\u0440\u0438 \u0441\u043B\u043E\u044F. \u0418\u0437\u0443\u0447\u0438
      \u043A\u0430\u0436\u0434\u044B\u0439."
    clip: {fileID: 8300000, guid: 0a277f841f083ad4c87dbfffbec75cc8, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0422\u044B \u043F\u043E\u043D\u044F\u043B, \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
      \u0421\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u043E\u0435 \u043F\u043E\u043B\u0435
      \u2014 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0436\u0438\u043C\u0430\u0442\u044C
      \u0441\u043E\u0441\u0443\u0434, \u043A\u0430\u043A \u0435\u0433\u043E \u043C\u044B\u0448\u0446\u044B."
    clip: {fileID: 8300000, guid: c4c23ed52059e7343b7e49448c64cde2, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0441\u0442\u0435\u043D\u043A\u0443
      \u0438 \u0434\u043E\u0436\u0434\u0438\u0441\u044C \u0443\u0434\u0430\u0440\u0430
      \u0441\u0435\u0440\u0434\u0446\u0430. \u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?"
    clip: {fileID: 8300000, guid: 24f7b0f79b7a8f947bd6bc32342ed5c7, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
