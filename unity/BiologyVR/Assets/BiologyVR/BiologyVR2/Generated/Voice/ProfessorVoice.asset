  - text: "\u041D\u0435 \u0442\u043E\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u2014 \u043A\u0430\u0441\u043A\u0430\u0434 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F.
      \u0412\u0441\u0451 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0442\u0440\u043E\u043C\u0431\u043E\u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430."
    clip: {fileID: 8300000, guid: c936c8f2e1c31ff468c048fa06fe5d1a, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0424\u0438\u0431\u0440\u0438\u043D\u043E\u0433\u0435\u043D \u0441\u0442\u0430\u043B
      \u0444\u0438\u0431\u0440\u0438\u043D\u043E\u043C! \u041F\u0440\u043E\u0448\u0435\u0439
      \u043F\u0440\u043E\u0431\u043A\u0443: \u0434\u0435\u0440\u0436\u0438 \u043A\u0443\u0440\u043E\u043A
      \u0438 \u0432\u0435\u0434\u0438 \u043B\u0443\u0447\u043E\u043C \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0440\u0430\u0437\u0440\u044B\u0432\u0430 \u2014 \u043E\u0442 \u043A\u0440\u0430\u044F
      \u043A \u043A\u0440\u0430\u044E."
    clip: {fileID: 8300000, guid: 0008288750e05a743a6f759524ab403a, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u041F\u0435\u0440\u0435\u0431\u043E\u0440! \u041B\u0438\u0448\u043D\u0438\u0439
      \u0444\u0438\u0431\u0440\u0438\u043D \u0440\u0430\u0441\u0442\u0451\u0442 \u0432
      \u043F\u0440\u043E\u0441\u0432\u0435\u0442 \u2014 \u044D\u0442\u043E \u0442\u0440\u043E\u043C\u0431."
    clip: {fileID: 8300000, guid: a5526fb416175044889a57e158a840c6, type: 3}
    fps: 50
    open: 
    round: 
    wide: 
  - text: "\u0421\u0433\u0443\u0441\u0442\u043E\u043A \u0434\u0435\u0440\u0436\u0438\u0442
      \u2014 \u0443\u0442\u0435\u0447\u043A\u0438 \u043D\u0435\u0442!"
