    wide: 
  - text: "\u0421\u043E\u0436\u043C\u0438 \u0441\u043E\u0441\u0443\u0434 \u043F\u043E\u043B\u0435\u043C
      \u2014 \u0442\u0430\u043A \u0434\u0435\u043B\u0430\u044E\u0442 \u0435\u0433\u043E
