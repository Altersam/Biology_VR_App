  m_Script: {fileID: 11500000, guid: 118a41d390873244e8f5f7a0131b4c3b, type: 3}
  m_Name: leukocyte
  m_EditorClassIdentifier: 
  id: leukocyte
  displayName: "\u041B\u0435\u0439\u043A\u043E\u0446\u0438\u0442"
  requiredForCompletion: 1
  professorComment: "\u042D\u0442\u043E \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A
    \u0438\u043C\u043C\u0443\u043D\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B.
    \u0417\u0430\u043C\u0435\u0442\u044C \u044F\u0434\u0440\u043E: \u043B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u044B
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F \u043D\u0430\u043C\u043D\u043E\u0433\u043E
    \u0440\u0435\u0436\u0435 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445
    \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432."
  pages:
  - heading: "\u0421\u0442\u0440\u043E\u0435\u043D\u0438\u0435"
    text: "\u2022 \u041B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u044B \u0438\u043C\u0435\u044E\u0442
      \u044F\u0434\u0440\u043E, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
      \u043E\u0442 \u0437\u0440\u0435\u043B\u044B\u0445 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432.\n\u2022
      \u041C\u043D\u043E\u0433\u0438\u0435 \u0438\u0437 \u043D\u0438\u0445 \u043A\u0440\u0443\u043F\u043D\u0435\u0435
      \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432.\n\u2022
      \u0418\u0445 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439
      \u043A\u0440\u043E\u0432\u0438."
    visualConnection: "\u042F\u0414\u0420\u041E \xB7 \u0420\u0415\u0414\u041A\u0410\u042F
      \u041A\u041B\u0415\u0422\u041A\u0410 \xB7 \u0417\u0410\u0429\u0418\u0422\u0410"
  - heading: "\u0418\u043C\u043C\u0443\u043D\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442"
    text: "\u2022 \u041B\u0435\u0439\u043A\u043E\u0446\u0438\u0442\u044B \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0438\u043C\u043C\u0443\u043D\u043D\u044B\u0435
      \u043A\u043B\u0435\u0442\u043A\u0438.\n\u2022 \u0427\u0430\u0441\u0442\u044C
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0439
      \u0444\u0430\u0433\u043E\u0446\u0438\u0442\u0430\u0440\u043D\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E.\n\u2022
      \u041B\u0438\u043C\u0444\u043E\u0446\u0438\u0442\u044B \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442
      \u0432 \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u043E\u0442\u0432\u0435\u0442\u0435.\n\u2022 \u041A\u043B\u0435\u0442\u043A\u0438
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0438\u0440\u0443\u044E\u0442 \u0432\u043E\u0441\u043F\u0430\u043B\u0435\u043D\u0438\u0435."
    visualConnection: "\u0420\u0410\u0421\u041F\u041E\u0417\u041D\u0410\u0412\u0410\u041D\u0418\u0415
      \u2192 \u0418\u041C\u041C\u0423\u041D\u041D\u042B\u0419 \u041E\u0422\u0412\u0415\u0422"
  - heading: "\u041A\u0440\u043E\u0432\u044C \u0438 \u0442\u043A\u0430\u043D\u0438"
    text: "\u2022 \u041B\u0435\u0439\u043A\u043E\u0446\u0438\u0442 \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043D\u043A\u0443
      \u0441\u043E\u0441\u0443\u0434\u0430 \u0432 \u0442\u043A\u0430\u043D\u0438.\n\u2022
      \u0421\u0438\u0433\u043D\u0430\u043B\u044B \u0432\u043E\u0441\u043F\u0430\u043B\u0435\u043D\u0438\u044F
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442 \u0435\u0433\u043E
      \u043A \u043E\u0447\u0430\u0433\u0443.\n\u2022 \u042D\u0442\u043E\u0442 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
      \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u0440\u0438
      \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0438 \u0437\u0430\u0449\u0438\u0442\u044B."
    visualConnection: "\u041A\u0420\u041E\u0412\u042C \u2192 \u0412\u042B\u0425\u041E\u0414
      \u0412 \u0422\u041A\u0410\u041D\u0418 \u2192 \u041E\u0427\u0410\u0413"
